{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(NODE_TLS_REJECT_UNAUTHORIZED=0 npx supabase *)",
      "Bash(xargs -I {} find {} -type f -name \"*.tsx\")",
      "Bash(npm install *)",
      "Bash(xargs sed -i '' 's/sx={{ py: 4 }}/sx={{ pt: 1.5, pb: 4 }}/g')",
      "Bash(supabase --version)",
      "Bash(supabase db *)",
      "Bash(npm view *)",
      "Bash(python3 -c \"import json,sys; d=json.load\\(sys.stdin\\); print\\(json.dumps\\(d.get\\('scripts',{}\\), indent=2\\)\\)\")",
      "Bash(npx biome *)",
      "Bash(echo \"tsc exit: $?\")",
      "Bash(xargs -I{} sh -c 'echo \"=={}==\"; cat {}')",
      "Bash(echo \"tsc: $?\")",
      "Bash(supabase status *)",
      "Bash(supabase migration *)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase"
  ]
}
